{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "app",
    "src/rn",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
